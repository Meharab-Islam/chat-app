# Node Server Environment
NODE_ENV=development
PORT=5050
CLIENT_URL=*

# MySQL Database
DATABASE_URL="mysql://root:rootpassword@localhost:3306/chat_db"

# Redis Cache
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Google Authentication
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# JWT Authentication
JWT_SECRET="chat-super-secure-jwt-secret-key-32-chars-long"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Media Uploads
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_REQUEST=10
UPLOAD_DIR="uploads"


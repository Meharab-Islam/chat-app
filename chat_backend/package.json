    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",

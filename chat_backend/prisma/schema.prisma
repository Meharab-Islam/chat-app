datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  googleId        String            @unique
  name            String
  avatarUrl       String?           @db.Text
  bio             String?           @default("")
  status          String?           @default("Available")
  isOnline        Boolean           @default(false)
  lastSeen        DateTime?
  fcmToken        String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  settings        UserSettings?
  memberships     ChatMember[]
  sentMessages    Message[]
  reactions       MessageReaction[]
  deletedMessages DeletedMessage[]

  @@index([email])
  @@index([googleId])
}

model UserSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  autoSaveToGallery Boolean  @default(true)
  mediaAutoDownload String   @default("all")
  notifications     Boolean  @default(true)
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Chat {
  id        String       @id @default(uuid())
  type      String       @default("direct")
  name      String?
  avatarUrl String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   ChatMember[]
  messages  Message[]
}

model ChatMember {
  id                String    @id @default(uuid())
  chatId            String
  userId            String
  role              String    @default("member")
  joinedAt          DateTime  @default(now())
  lastReadAt        DateTime?
  lastReadMessageId String?
  chat              Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
  @@index([chatId])
}

model Message {
  id          String            @id @default(uuid())
  chatId      String
  senderId    String
  text        String?           @db.Text
  type        String            @default("text")
  status      String            @default("sent")
  deliveredAt DateTime?
  readAt      DateTime?
  isForwarded Boolean           @default(false)
  isUnsent    Boolean           @default(false)
  replyToId   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  chat        Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo     Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]         @relation("MessageReplies")
  attachments Attachment[]
  reactions   MessageReaction[]
  deletedFor  DeletedMessage[]

  @@index([chatId, createdAt])
  @@index([senderId])
}

model Attachment {
  id           String   @id @default(uuid())
  messageId    String?
  fileName     String
  fileUrl      String   @db.Text
  fileType     String
  mimeType     String
  fileSize     Int
  thumbnailUrl String?  @db.Text
  createdAt    DateTime @default(now())
  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model DeletedMessage {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}
